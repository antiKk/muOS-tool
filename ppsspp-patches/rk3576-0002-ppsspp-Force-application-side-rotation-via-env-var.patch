@@ -1130,8 +1130,22 @@ void VulkanRenderManager::BindFramebuffe
 	} else {
 		curWidthRaw_ = vulkan_->GetBackbufferWidth();
 		curHeightRaw_ = vulkan_->GetBackbufferHeight();
-		if (g_display.rotation == DisplayRotation::ROTATE_90 ||
-			g_display.rotation == DisplayRotation::ROTATE_270) {
+		// curWidth_/curHeight_ feed renderArea, which is then transformed by
+		// RotateRectToDisplay (in VulkanQueueRunner) into the actual VkRect2D
+		// for the renderpass.  RotateRectToDisplay expects the *input* rect's
+		// dims to be the swapped form of the destination (swapchain image)
+		// dims.  When driver-side rotation is in effect, swapchain images are
+		// at swapped/logical dims, so we swap curWidthRaw_/curHeightRaw_.
+		// When application-side rotation is in effect (PPSSPP_DISPLAY_ROTATION
+		// on Mali rk3576 etc.), swapchain images stay at physical dims while
+		// GetBackbufferWidth/Height already report logical dims; in that case
+		// we must NOT swap, because GetBackbufferWidth/Height are already the
+		// "swapped" form of the destination dims.
+		const bool appSideRotation =
+			vulkan_->GetBackbufferWidth() != vulkan_->GetSwapchainImageWidth() ||
+			vulkan_->GetBackbufferHeight() != vulkan_->GetSwapchainImageHeight();
+		if (!appSideRotation && (g_display.rotation == DisplayRotation::ROTATE_90 ||
+			g_display.rotation == DisplayRotation::ROTATE_270)) {
 			curWidth_ = curHeightRaw_;
 			curHeight_ = curWidthRaw_;
 		} else {
