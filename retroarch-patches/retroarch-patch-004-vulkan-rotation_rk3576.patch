+/* Display rotation: read fbcon=rotate:N from the kernel command line and
+ * advertise *swapped* dimensions to RetroArch's outer layer when the
+ * orientation is portrait. This makes get_video_size() report landscape
+ * (e.g., 1920x1080) even though Mesa's KHR_display owns a portrait
+ * (1080x1920) swapchain. The actual rotation blit happens later in
+ * gfx/drivers/vulkan.c.
+ *
+ * Kept identical in spirit to drm_rga_get_rotation() in drm_ctx.c so the
+ * GL and Vulkan paths agree on the rotation source-of-truth. */
+static unsigned khr_display_get_rotation(void)
+{
+   FILE *fp = fopen("/proc/cmdline", "r");
+   char buf[4096], *p;
+   unsigned r = 0;
+   if (!fp)
+      return 0;
+   if (fgets(buf, sizeof(buf), fp))
+   {
+      p = strstr(buf, "fbcon=rotate:");
+      if (p)
+      {
+         p += 13;
+         r  = (unsigned)atoi(p);
+         if (r > 3)
+            r = 0;
+      }
+   }
+   fclose(fp);
+   return r;
+}
