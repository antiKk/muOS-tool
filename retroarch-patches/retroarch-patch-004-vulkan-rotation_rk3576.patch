+   if (vk->display_rotation)
+   {
+      if (!vulkan_init_rotation_resources(vk))
+      {
+         RARCH_ERR("[Vulkan] display_rot: init failed; "
+               "disabling rotation for this session.\n");
+         vk->display_rotation = 0;
+      }
+   }
 }
 
